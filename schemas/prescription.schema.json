{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://receta.mx/schemas/prescription.schema.json",
  "title": "Receta MX Alpha",
  "type": "object",
  "required": ["schema", "folio", "issued_at", "valid_until", "patient", "prescriber", "items", "catalog_version"],
  "properties": {
    "schema": {"const": "receta-mx-alpha-0.1.0"},
    "folio": {"type": "string", "pattern": "^RXMX-[0-9]{4}-[A-F0-9]{12}$"},
    "issued_at": {"type": "string", "format": "date-time"},
    "valid_until": {"type": "string", "format": "date-time"},
    "patient": {
      "type": "object",
      "required": ["identifier_type", "identifier_value", "full_name"],
      "properties": {
        "identifier_type": {"enum": ["CURP", "TEMP_RURAL", "NEWBORN", "FOREIGN", "OTHER"]},
        "identifier_value": {"type": "string", "minLength": 1},
        "full_name": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "prescriber": {
      "type": "object",
      "required": ["prescriber_number", "professional_license", "full_name", "profession"],
      "properties": {
        "prescriber_number": {"type": "string", "pattern": "^MXP-[A-Z]{3}-[0-9]{10}$"},
        "professional_license": {"type": "string"},
        "full_name": {"type": "string"},
        "profession": {"type": "string"}
      },
      "additionalProperties": false
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["generic_name", "form", "strength", "dose", "route", "frequency", "quantity_prescribed", "sale_fraction", "controlled_group"],
        "properties": {
          "code": {"type": ["string", "null"]},
          "generic_name": {"type": "string"},
          "brand_requested": {"type": ["string", "null"]},
          "form": {"type": "string"},
          "strength": {"type": "string"},
          "dose": {"type": "string"},
          "route": {"type": "string"},
          "frequency": {"type": "string"},
          "duration_days": {"type": ["integer", "null"], "minimum": 1},
          "quantity_prescribed": {"type": "number", "exclusiveMinimum": 0},
          "sale_fraction": {"enum": ["I", "II", "III", "IV", "V", "VI"]},
          "controlled_group": {"enum": ["NONE", "ESTUPEFACIENTE", "PSICOTROPICO_II", "PSICOTROPICO_III", "PSICOTROPICO_IV"]},
          "refills_authorized": {"type": "integer", "minimum": 0},
          "substitution_allowed": {"type": "boolean"},
          "warnings": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    },
    "diagnosis_code": {"type": ["string", "null"]},
    "clinical_note": {"type": ["string", "null"]},
    "public_origin": {"type": "boolean"},
    "fulfillment_route": {"enum": ["PUBLIC_ONLY", "PRIVATE_ONLY", "ANY_AUTHORIZED_PHARMACY", "PUBLIC_FIRST_PRIVATE_FALLBACK"]},
    "payer_type": {"type": "string"},
    "transfer_reason": {"type": ["string", "null"]},
    "catalog_version": {"type": "string"}
  },
  "additionalProperties": true
}
